# ==============================================================================
# SERVER-SIDE ONLY SECRETS (NEVER PREFIX WITH VITE_ / NEXT_PUBLIC_ / REACT_APP_)
# ==============================================================================

# Gemini AI API Key (server-side proxy only)
GEMINI_API_KEY="your_gemini_api_key"

# Canonical Application URL
APP_URL="http://localhost:3000"

# Google Maps Platform Server Key (Geocoding & Routes API v2 proxy)
GOOGLE_MAPS_API_KEY="your_server_google_maps_api_key"

# Cashfree Payments Marketplace Easy Split (Server-side only)
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_ENVIRONMENT="sandbox"
CASHFREE_API_VERSION="2023-08-01"

# httpSMS Android Jio SMS Gateway Credentials (Server-side only)
HTTPSMS_API_KEY="your_httpsms_api_key"
MY_JIO_PHONE_NUMBER="+919999999999"

# Supabase PostgreSQL Backend (Service Role key must NEVER be exposed to the browser)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Super Admin Console Authentication (Server-side only — REQUIRED in production)
SUPER_ADMIN_EMAIL="owner@example.com"
ZUGGI_ADMIN_PASSCODE="replace_with_strong_admin_passcode"

# HMAC Signing Secrets for Session JWTs & Live Trip Tracking Tokens (REQUIRED in production, min 32 chars)
SESSION_TOKEN_SECRET="replace_with_64_char_random_hex_secret"
TRACKING_TOKEN_SECRET="replace_with_64_char_random_hex_secret"

# Strict CORS Origin Allowlist (comma-separated frontend origins — REQUIRED in production)
ALLOWED_ORIGINS="https://zuggi.in,https://www.zuggi.in,https://partner.zuggi.in"

# Debug mode (must remain false in production)
DEBUG_MODE="false"

# Custom Domain & Android Play Store TWA Configuration
PRIMARY_DOMAIN="zuggi.in"
PARTNER_SUBDOMAIN="partner.zuggi.in"
ANDROID_TWA_PACKAGE_NAME="in.zuggi.partner"
ANDROID_TWA_SHA256_FINGERPRINT=""

# ==============================================================================
# PUBLIC BROWSER-SAFE VARIABLES (EXPOSED TO CLIENT BUNDLE VIA VITE_)
# Restrict API keys by HTTP referrer in Google Cloud Console before launch.
# ==============================================================================

# Google Maps JavaScript SDK browser key (restrict by HTTP referrer)
VITE_GOOGLE_MAPS_API_KEY="your_browser_restricted_google_maps_api_key"

# Business Direct UPI Merchant Display Details (Public checkout info)
VITE_ZUGGI_MERCHANT_UPI="yourbusiness@upi"
VITE_ZUGGI_MERCHANT_NAME="Zuggi Freight Logistics"