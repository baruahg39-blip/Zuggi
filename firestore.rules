rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPlatformOwner() {
      return isSignedIn() && (
        request.auth.token.email == 'baruahg39@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isPlatformOwner();
      allow write: if isPlatformOwner();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isUser(userId) || isPlatformOwner();
      allow create: if isUser(userId) && request.resource.data.role != 'admin';
      allow update: if (isUser(userId) && request.resource.data.role == resource.data.role) || isPlatformOwner();
      allow delete: if isPlatformOwner();
    }

    // Shippers Collection
    match /shippers/{shipperId} {
      allow read: if isUser(shipperId) || isPlatformOwner();
      allow write: if isUser(shipperId) || isPlatformOwner();
    }

    // Drivers Collection
    match /drivers/{driverId} {
      allow read: if isUser(driverId) || isPlatformOwner();
      allow write: if isUser(driverId) || isPlatformOwner();
    }

    // Vehicles Collection
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if (isSignedIn() && request.resource.data.ownerId == request.auth.uid) || isPlatformOwner();
    }

    // Loads Collection (Marketplace)
    match /loads/{loadId} {
      // Drivers and Shippers can read posted loads
      allow read: if isSignedIn();
      // Only the shipper can create a load under their UID
      allow create: if isSignedIn() && (
        request.resource.data.shipperId == request.auth.uid ||
        request.resource.data.customerId == request.auth.uid
      );
      // Shipper or Admin can update their load; Drivers can trigger bid count increments and status updates during award
      allow update: if (isSignedIn() && (
        resource.data.shipperId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        isPlatformOwner()
      )) || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bidsCount', 'lowestBid', 'status', 'assignedBookingId', 'awardedDriverId', 'deliveryOtp']));
      allow delete: if (isSignedIn() && (
        resource.data.shipperId == request.auth.uid ||
        resource.data.customerId == request.auth.uid
      )) || isPlatformOwner();
    }

    // Bids Collection
    match /bids/{bidId} {
      // Drivers see only their own bids; Shipper of the load sees bids for their load; Admin sees all
      allow read: if isSignedIn() && (
        resource.data.driverId == request.auth.uid ||
        resource.data.transporterId == request.auth.uid ||
        resource.data.shipperId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        isPlatformOwner()
      );
      // Only driver/transporter can submit bid under their own UID
      allow create: if isSignedIn() && (
        request.resource.data.driverId == request.auth.uid ||
        request.resource.data.transporterId == request.auth.uid
      );
      // Driver can update/revise their own bid before award; Shipper can update status to accepted/rejected
      allow update: if isSignedIn() && (
        ((resource.data.driverId == request.auth.uid || resource.data.transporterId == request.auth.uid) && (resource.data.status == 'submitted' || resource.data.status == 'countered')) ||
        resource.data.shipperId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        isPlatformOwner()
      );
      allow delete: if (isSignedIn() && (resource.data.driverId == request.auth.uid || resource.data.transporterId == request.auth.uid)) || isPlatformOwner();
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.shipperId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.transporterId == request.auth.uid ||
        isPlatformOwner()
      );
      allow create: if isSignedIn() && (
        request.resource.data.shipperId == request.auth.uid ||
        request.resource.data.customerId == request.auth.uid ||
        isPlatformOwner()
      );
      allow update: if isSignedIn() && (
        resource.data.shipperId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.transporterId == request.auth.uid ||
        isPlatformOwner()
      );
      allow delete: if isPlatformOwner();
    }

    // Trip Feedbacks Collection
    match /trip_feedbacks/{feedbackId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.shipperId == request.auth.uid
      );
      allow update: if (isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.shipperId == request.auth.uid
      )) || isPlatformOwner();
      allow delete: if isPlatformOwner();
    }

    // Transactions / Payments Collection
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (
        resource.data.payerId == request.auth.uid ||
        resource.data.payeeId == request.auth.uid ||
        isPlatformOwner()
      );
      allow write: if isPlatformOwner();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isPlatformOwner());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Support Tickets Collection
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isPlatformOwner());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isPlatformOwner() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isPlatformOwner();
    }

    // Verification Documents Collection
    match /verification_documents/{docId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isPlatformOwner());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isPlatformOwner();
      allow delete: if isPlatformOwner();
    }

    // Audit Logs Collection
    match /audit_logs/{logId} {
      allow read: if isPlatformOwner();
      allow create: if isPlatformOwner();
      allow update, delete: if false; // Immutable audit logs
    }

    // Platform Settings Collection
    match /platform_settings/{settingId} {
      allow read: if true; // Public read for commission calculation and support info
      allow write: if isPlatformOwner();
    }

    // Trips Collection
    match /trips/{tripId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isPlatformOwner();

      match /pings/{pingId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isPlatformOwner();
      }
    }
  }
}
