{
  "id": "/partner",
  "name": "Zuggi Partner - Driver & Fleet App",
  "short_name": "Zuggi App",
  "description": "Dedicated mobile app for commercial truck drivers, vehicle owners, and fleet partners. Browse daily loads, submit bids, dispatch fleet, capture e-POD, and track GPS earnings.",
  "start_url": "/partner",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "theme_color": "#060309",
  "background_color": "#060309",
  "categories": ["logistics", "business", "navigation"],
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/playstore-screenshot-mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Zuggi Partner Driver & Fleet Mobile App"
    },
    {
      "src": "/playstore-screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Zuggi Partner Fleet Dispatch & Freight Exchange"
    }
  ],
  "shortcuts": [
    {
