      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My Active Trip",
      "short_name": "Active Trip",
      "description": "Manage live dispatched trip, GPS tracking, and e-POD delivery",
      "url": "/partner?view=trips",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
